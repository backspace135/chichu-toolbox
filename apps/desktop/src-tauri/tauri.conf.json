{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "彳亍工具箱",
  "version": "0.0.0",
  "identifier": "com.chichu.toolbox.desktop.dev",
  "build": {
    "beforeDevCommand": "python3 scripts/prepare_platform_tools.py && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "python3 scripts/prepare_platform_tools.py && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "彳亍工具箱",
      "width": 1360, "height": 900, "minWidth": 980, "minHeight": 640,
      "resizable": true, "decorations": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "resources": { "resources/platform-tools/": "platform-tools/" },
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "14.0" },
    "windows": { "webviewInstallMode": { "type": "offlineInstaller" } }
  }
}
