diff --git a/kernel/hook/syscall_hook.h b/kernel/hook/syscall_hook.h
index d4921bf9..f63a4d31 100644
--- a/kernel/hook/syscall_hook.h
+++ b/kernel/hook/syscall_hook.h
@@ -1,11 +1,34 @@
 #ifndef __KSU_H_KSU_SYSCALL_HOOK
 #define __KSU_H_KSU_SYSCALL_HOOK
 #include <asm/syscall.h>
+#include <linux/version.h>
 
-#if defined(__x86_64__)
-typedef sys_call_ptr_t syscall_fn_t;
-#elif defined(__riscv)
+// 4.14 arm64 kernels define no __nocfi; provide the clang attribute under CFI.
+#ifndef __nocfi
+#ifdef CONFIG_CFI_CLANG
+#define __nocfi __attribute__((no_sanitize("cfi")))
+#else
+#define __nocfi
+#endif
+#endif
+ 
+ #if defined(__x86_64__)
+ typedef sys_call_ptr_t syscall_fn_t;
+ #elif defined(__riscv)
+ typedef long (*syscall_fn_t)(const struct pt_regs *);
+ #endif
+
+#if defined(__aarch64__) && LINUX_VERSION_CODE < KERNEL_VERSION(4, 17, 0)
+// 4.14 arm64 syscall table entries take unpacked user arguments; they cannot be
+// called with pt_regs like on 4.17+. Expand the six argument slots instead,
+// and keep these indirect calls out of CFI checking (per-syscall prototypes differ).
 typedef long (*syscall_fn_t)(const struct pt_regs *);
+#define KSU_SYSCALL_CALL(nr, regs)                                                                     \
+    ((long (*)(unsigned long, unsigned long, unsigned long, unsigned long, unsigned long, unsigned long)) \
+         ksu_syscall_table[nr])                                                                        \
+        ((regs)->regs[0], (regs)->regs[1], (regs)->regs[2], (regs)->regs[3], (regs)->regs[4], (regs)->regs[5])
+#else
+#define KSU_SYSCALL_CALL(nr, regs) ksu_syscall_table[nr](regs)
 #endif
 
 extern syscall_fn_t *ksu_syscall_table;
